{
  "props": {
    "type": {
      "type": "string",
      "default": "button",
      "enum": [
        "button",
        "submit",
        "reset"
      ]
    },
    "variant": {
      "type": "string",
      "default": "primary",
      "enum": [
        "primary",
        "secondary",
        "ghost",
        "danger"
      ]
    },
    "size": {
      "type": "string",
      "default": "md",
      "enum": [
        "sm",
        "md",
        "lg"
      ]
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "string",
      "nullable": true
    },
    "value": {
      "type": "string",
      "nullable": true
    }
  },
  "slots": {
    "default": {
      "required": true
    }
  }
}
