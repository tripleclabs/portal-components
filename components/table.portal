<props>
  <prop name="caption" type="string" required="true"/>
  <slot name="head"/>
  <slot name="default" required="true"/>
</props>

<template>
<div class="portal-table-wrap" tabindex="0" role="region" t:attr-aria-label="props.caption">
  <table class="portal-table">
    <caption t:text="props.caption"/>
    <thead t:if="slots.head">
      <ui:outlet name="head"/>
    </thead>
    <tbody>
      <ui:outlet name="default"/>
    </tbody>
  </table>
</div>
</template>
