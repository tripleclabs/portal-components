{
  "props": {
    "direction": {
      "type": "string",
      "default": "vertical",
      "enum": [
        "vertical",
        "horizontal"
      ]
    },
    "gap": {
      "type": "string",
      "default": "md",
      "enum": [
        "sm",
        "md",
        "lg"
      ]
    },
    "align": {
      "type": "string",
      "default": "stretch",
      "enum": [
        "stretch",
        "start",
        "center",
        "end"
      ]
    }
  },
  "slots": {
    "default": {
      "required": true
    }
  }
}
