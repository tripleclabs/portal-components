<props>
  <prop name="open" type="boolean" default="false"/>
  <slot name="summary" required="true"/>
  <slot name="default" required="true"/>
</props>

<template>
<details class="portal-disclosure" t:attr-open="props.open">
  <summary>
    <ui:outlet name="summary"/>
  </summary>
  <div class="portal-disclosure__body">
    <ui:outlet name="default"/>
  </div>
</details>
</template>

<style>
/* Disclosure */
.portal-disclosure {
  border: 1px solid var(--_hairline);
  border-radius: var(--portal-radius);
  background: var(--portal-surface);
}
.portal-disclosure summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--_s)*3);
  padding-block: calc(var(--_s)*3);
  padding-inline: calc(var(--_s)*4);
  border-radius: inherit;
  font-weight: var(--_portal-weight-medium);
  list-style: none;
  cursor: pointer;
  transition: background-color var(--portal-motion);
}
.portal-disclosure summary::-webkit-details-marker { display: none; }
.portal-disclosure summary::after {
  content: "";
  flex: none;
  inline-size: .5rem;
  block-size: .5rem;
  margin-block-start: -.25rem;
  border-block-end: 1.5px solid var(--portal-text-muted);
  border-inline-end: 1.5px solid var(--portal-text-muted);
  transform: rotate(45deg);
  transition: transform var(--portal-motion);
}
.portal-disclosure[open] > summary::after { transform: rotate(225deg); margin-block-start: .25rem; }
.portal-disclosure summary:dir(rtl)::after { transform: rotate(-45deg); }
.portal-disclosure[open] > summary:dir(rtl)::after { transform: rotate(-225deg); }
.portal-disclosure summary:hover { background: color-mix(in oklab, var(--portal-surface-muted) 60%, var(--portal-surface)); }
.portal-disclosure[open] > summary { border-end-start-radius: 0; border-end-end-radius: 0; }
.portal-disclosure__body {
  padding-inline: calc(var(--_s)*4);
  padding-block-end: calc(var(--_s)*4);
  color: var(--portal-text);
}
.portal-disclosure__body > :first-child { margin-block-start: 0; }
.portal-disclosure__body > :last-child { margin-block-end: 0; }
</style>
