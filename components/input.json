{
  "props": {
    "id": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "invalid": {
      "type": "boolean",
      "default": false
    },
    "describedby": {
      "type": "string",
      "nullable": true
    },
    "autocomplete": {
      "type": "string",
      "nullable": true
    },
    "type": {
      "type": "string",
      "default": "text",
      "enum": [
        "text",
        "email",
        "tel",
        "url",
        "number",
        "password",
        "search",
        "date",
        "time",
        "datetime-local",
        "month",
        "week",
        "color",
        "range"
      ]
    },
    "placeholder": {
      "type": "string",
      "nullable": true
    },
    "readonly": {
      "type": "boolean",
      "default": false
    },
    "inputmode": {
      "type": "string",
      "nullable": true
    },
    "min": {
      "type": "string",
      "nullable": true
    },
    "max": {
      "type": "string",
      "nullable": true
    },
    "step": {
      "type": "string",
      "nullable": true
    }
  },
  "slots": {}
}
