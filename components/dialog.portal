<props>
  <prop name="id" type="string" required="true"/>
  <prop name="title" type="string" required="true"/>
  <prop name="triggerVariant" type="string" default="secondary" enum="primary secondary ghost"/>
  <prop name="closeLabel" type="string" default="Close"/>
  <slot name="trigger" required="true"/>
  <slot name="default" required="true"/>
  <slot name="footer"/>
</props>

<template>
<div class="portal-dialog" data-portal-behavior="dialog">
  <button type="button" class="portal-button" data-portal-command="open" command="show-modal" data-portal-enhanced-only="" hidden="hidden" t:attr-commandfor="props.id" t:attr-data-variant="props.triggerVariant">
    <ui:outlet name="trigger"/>
  </button>
  <dialog class="portal-dialog__panel" t:attr-id="props.id" t:attr-aria-labelledby="props.id | append:'-title'">
    <header class="portal-dialog__header">
      <h2 t:attr-id="props.id | append:'-title'" t:text="props.title"/>
      <button type="button" class="portal-dialog__close" data-portal-command="close" command="close" t:attr-commandfor="props.id" t:attr-aria-label="props.closeLabel">
        <ui:icon name="x"/>
      </button>
    </header>
    <div class="portal-dialog__body">
      <ui:outlet name="default"/>
    </div>
    <footer class="portal-dialog__footer" t:if="slots.footer">
      <ui:outlet name="footer"/>
    </footer>
  </dialog>
</div>
</template>

<style>
/* Overlays. Dialogs and popovers render in the top layer but inherit tokens. */
.portal-dialog { display: contents; }
.portal-dialog__panel { border: 1px solid var(--_hairline); background: var(--portal-surface); color: var(--portal-text); box-shadow: var(--portal-shadow-lg); }
.portal-dialog__panel { inline-size: min(32rem, calc(100% - 2rem)); max-block-size: calc(100% - 2rem); padding: 0; border-radius: calc(var(--portal-radius)*1.5); }
.portal-dialog__panel::backdrop { background: rgb(9 9 11 / .5); }
.portal-dialog__header { display: flex; align-items: flex-start; justify-content: space-between; gap: calc(var(--_s)*4); padding: calc(var(--_s)*5) calc(var(--_s)*6) 0; }
.portal-dialog__header h2 { margin: 0; font-size: 1.25rem; overflow-wrap: anywhere; }
.portal-dialog__body { padding: calc(var(--_s)*3) calc(var(--_s)*6) calc(var(--_s)*6); color: var(--portal-text-muted); }
.portal-dialog__body > :first-child { margin-block-start: 0; }
.portal-dialog__body > :last-child { margin-block-end: 0; }
.portal-dialog__footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: calc(var(--_s)*3); padding: calc(var(--_s)*4) calc(var(--_s)*6); border-block-start: 1px solid var(--_hairline); background: var(--_subtle); font-size: .875rem; }
.portal-dialog__close { display: inline-flex; align-items: center; gap: .375rem; border: 0; border-radius: var(--portal-radius); background: none; color: var(--portal-text-muted); font: inherit; cursor: pointer; transition: color var(--portal-motion), background-color var(--portal-motion); }
.portal-dialog__close { flex: none; justify-content: center; inline-size: 2rem; block-size: 2rem; margin: -.25rem; }
.portal-dialog__close:hover { background: var(--portal-surface-muted); color: var(--portal-text); }
</style>
