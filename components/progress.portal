<props>
  <prop name="value" type="number" default="0"/>
  <prop name="max" type="number" default="100"/>
  <prop name="label" type="string" required="true"/>
</props>

<template>
<label class="portal-progress">
  <span t:text="props.label"/>
  <progress t:attr-value="props.value" t:attr-max="props.max"/>
</label>
</template>

<style>
/* Progress */
.portal-progress { display: grid; gap: calc(var(--_s)*2); font-size: .875rem; font-weight: var(--_portal-weight-medium); }
.portal-progress progress {
  appearance: none;
  inline-size: 100%;
  block-size: .5rem;
  border: 0;
  border-radius: 999px;
  overflow: hidden;
  background: var(--portal-surface-muted);
  accent-color: var(--_primary);
}
.portal-progress progress::-webkit-progress-bar { background: var(--portal-surface-muted); border-radius: 999px; }
.portal-progress progress::-webkit-progress-value { background: var(--_primary); border-radius: 999px; transition: inline-size var(--portal-motion); }
.portal-progress progress::-moz-progress-bar { background: var(--_primary); border-radius: 999px; }
</style>
